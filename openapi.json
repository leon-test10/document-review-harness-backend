                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "run_id": {
                      "type": "string",
                      "pattern": "^run_[a-f0-9]{32}$"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "run_id",
